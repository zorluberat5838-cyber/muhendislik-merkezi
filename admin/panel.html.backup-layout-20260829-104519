<script>

(function(){

    let originalSettings = {};
    let currentSettings = {};

    const fields = [
        "site_name",
        "site_description",
        "hero_title",
        "hero_text",
        "technician",
        "footer_text"
    ];


    function setStatus(message, type){

        const el =
            document.getElementById("custom-status");

        if(!el) return;

        el.textContent = message;

        if(type === "success"){
            el.style.color = "#4ade80";
        }else if(type === "error"){
            el.style.color = "#fb7185";
        }else{
            el.style.color = "#94a3b8";
        }
    }


    function updatePreview(){

        fields.forEach(field => {

            const input =
                document.getElementById(
                    "custom-" + field
                );

            const preview =
                document.getElementById(
                    "preview-" + field
                );

            if(!input || !preview) return;

            preview.textContent =
                input.value || "—";

        });

    }


    function loadInputs(settings){

        fields.forEach(field => {

            const input =
                document.getElementById(
                    "custom-" + field
                );

            if(input){
                input.value =
                    settings[field] || "";
            }

        });

        updatePreview();
    }


    async function loadSettings(){

        setStatus(
            "Site ayarları yükleniyor..."
        );

        try{

            const response =
                await fetch("/api/customization");

            if(!response.ok){
                throw new Error("HTTP " + response.status);
            }

            const data =
                await response.json();

            if(!data.success){
                throw new Error(
                    data.message ||
                    "Ayarlar alınamadı."
                );
            }

            originalSettings =
                JSON.parse(
                    JSON.stringify(
                        data.settings || {}
                    )
                );

            currentSettings =
                JSON.parse(
                    JSON.stringify(
                        data.settings || {}
                    )
                );

            loadInputs(currentSettings);

            setStatus(
                "✓ Ayarlar yüklendi.",
                "success"
            );

        }catch(error){

            console.error(error);

            setStatus(
                "❌ Ayarlar yüklenemedi.",
                "error"
            );
        }
    }


    async function saveSettings(){

        const settings = {};

        fields.forEach(field => {

            const input =
                document.getElementById(
                    "custom-" + field
                );

            settings[field] =
                input ? input.value : "";

        });

        setStatus(
            "⏳ Değişiklikler yayınlanıyor..."
        );

        try{

            const response =
                await fetch(
                    "/api/admin/customization",
                    {
                        method:"PUT",
                        headers:{
                            "Content-Type":
                                "application/json"
                        },
                        body:
                            JSON.stringify(settings)
                    }
                );

            const data =
                await response.json();

            if(!response.ok || !data.success){
                throw new Error(
                    data.message ||
                    "Kaydetme başarısız."
                );
            }

            originalSettings =
                JSON.parse(
                    JSON.stringify(
                        data.settings || settings
                    )
                );

            currentSettings =
                JSON.parse(
                    JSON.stringify(
                        data.settings || settings
                    )
                );

            loadInputs(currentSettings);

            setStatus(
                "✓ Değişiklikler yayınlandı. Site artık yeni ayarları kullanıyor.",
                "success"
            );

        }catch(error){

            console.error(error);

            setStatus(
                "❌ " + error.message,
                "error"
            );
        }
    }


    function resetSettings(){

        loadInputs(originalSettings);

        setStatus(
            "↩ Kaydedilmemiş değişiklikler geri alındı."
        );
    }


    fields.forEach(field => {

        const input =
            document.getElementById(
                "custom-" + field
            );

        if(input){

            input.addEventListener(
                "input",
                function(){

                    currentSettings[field] =
                        input.value;

                    updatePreview();

                    setStatus(
                        "● Kaydedilmemiş değişiklikler var."
                    );
                }
            );

        }

    });


    const save =
        document.getElementById(
            "custom-save"
        );

    const reset =
        document.getElementById(
            "custom-reset"
        );

    const refresh =
        document.getElementById(
            "custom-refresh"
        );


    if(save){
        save.addEventListener(
            "click",
            saveSettings
        );
    }

    if(reset){
        reset.addEventListener(
            "click",
            resetSettings
        );
    }

    if(refresh){
        refresh.addEventListener(
            "click",
            loadSettings
        );
    }


    loadSettings();

})();

</script>


