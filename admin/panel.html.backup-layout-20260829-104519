<script>

let engineeringEditorData = [];
let selectedEngineeringId = null;


/* =========================================================
   YARDIMCI
========================================================= */

function linesToArray(value){

    return value
        .split("\\n")
        .map(x => x.trim())
        .filter(Boolean);

}

function arrayToLines(value){

    if(Array.isArray(value)){
        return value.join("\\n");
    }

    if(!value){
        return "";
    }

    return String(value);

}


/* =========================================================
   MÜHENDİSLİKLERİ GETİR
========================================================= */

async function loadEngineeringEditor(){

    const list =
        document.getElementById("engineeringEditorList");

    try{

        const response =
            await fetch("/api/engineering", {
                credentials:"same-origin"
            });

        if(response.status === 401 ||
           response.status === 403){

            window.location.href="/admin";
            return;

        }

        if(!response.ok){
            throw new Error("Mühendislikler alınamadı.");
        }

        engineeringEditorData =
            await response.json();

        renderEngineeringEditorList();

        if(
            engineeringEditorData.length &&
            selectedEngineeringId === null
        ){

            selectEngineeringEditor(
                engineeringEditorData[0].id
            );

        }

    }catch(error){

        console.error(error);

        list.innerHTML = `
            <div class="eng-empty">
                ❌ Mühendislikler yüklenemedi.
                <br><br>
                <small>${error.message}</small>
            </div>
        `;

    }

}


/* =========================================================
   LİSTE
========================================================= */

function renderEngineeringEditorList(){

    const list =
        document.getElementById("engineeringEditorList");

    if(!engineeringEditorData.length){

        list.innerHTML = `
            <div class="eng-empty">
                Henüz mühendislik bulunmuyor.
            </div>
        `;

        return;

    }

    list.innerHTML =
        engineeringEditorData.map(item => `

            <button
                type="button"
                class="engineering-editor-item ${
                    Number(item.id) === Number(selectedEngineeringId)
                    ? "active"
                    : ""
                }"
                onclick="selectEngineeringEditor(${Number(item.id)})">

                <strong>
                    ⚙️ ${escapeHtml(item.name || "Mühendislik")}
                </strong>

                <small>
                    ID: ${Number(item.id)}
                </small>

            </button>

        `).join("");

}


/* =========================================================
   MÜHENDİSLİK SEÇ
========================================================= */

function selectEngineeringEditor(id){

    const item =
        engineeringEditorData.find(
            x => Number(x.id) === Number(id)
        );

    if(!item) return;

    selectedEngineeringId = item.id;

    document.getElementById("engineeringEditorTitle").textContent =
        "✏️ " + (item.name || "Mühendislik") + " Düzenle";

    document.getElementById("editorEngineeringId").value =
        item.id ?? "";

    document.getElementById("editorEngineeringName").value =
        item.name ?? "";

    document.getElementById("editorEngineeringShort").value =
        item.kisa ??
        item.short ??
        item.shortDescription ??
        "";

    document.getElementById("editorEngineeringDescription").value =
        item.nedir ??
        item.description ??
        "";

    document.getElementById("editorEngineeringWork").value =
        arrayToLines(
            item.isler ??
            item.work ??
            []
        );

    document.getElementById("editorEngineeringSubjects").value =
        arrayToLines(
            item.dersler ??
            item.subjects ??
            item.education ??
            []
        );

    document.getElementById("editorEngineeringFields").value =
        arrayToLines(
            item.alanlar ??
            item.fields ??
            []
        );

    document.getElementById("editorEngineeringSuitable").value =
        item.uygun ??
        item.suitable ??
        "";

    document.getElementById("editorEngineeringCareer").value =
        item.kariyer ??
        item.career ??
        "";

    document.getElementById("editorEngineeringTags").value =
        arrayToLines(
            item.etiket ??
            item.tags ??
            []
        );

    document.getElementById("editorEngineeringSalary").value =
        item.salary ??
        "";

    document.getElementById("engineeringEditorMessage").innerHTML =
        "";

    renderEngineeringEditorList();

}


/* =========================================================
   YENİ MÜHENDİSLİK
========================================================= */

function engineeringEditorNew(){

    selectedEngineeringId = null;

    document.getElementById("engineeringEditorTitle").textContent =
        "➕ Yeni Mühendislik";

    document.getElementById("editorEngineeringId").value = "";

    document.getElementById("editorEngineeringName").value = "";
    document.getElementById("editorEngineeringShort").value = "";
    document.getElementById("editorEngineeringDescription").value = "";
    document.getElementById("editorEngineeringWork").value = "";
    document.getElementById("editorEngineeringSubjects").value = "";
    document.getElementById("editorEngineeringFields").value = "";
    document.getElementById("editorEngineeringSuitable").value = "";
    document.getElementById("editorEngineeringCareer").value = "";
    document.getElementById("editorEngineeringTags").value = "";
    document.getElementById("editorEngineeringSalary").value = "";

    document.getElementById("engineeringDeleteButton").style.display =
        "none";

    document.getElementById("engineeringEditorMessage").innerHTML =
        "📝 Yeni mühendislik bilgilerini doldur.";

    renderEngineeringEditorList();

}


/* =========================================================
   KAYDET VE YAYINLA
========================================================= */

async function saveEngineeringEditor(){

    const id =
        document.getElementById("editorEngineeringId").value.trim();

    const name =
        document.getElementById("editorEngineeringName").value.trim();

    const kisa =
        document.getElementById("editorEngineeringShort").value.trim();

    const nedir =
        document.getElementById("editorEngineeringDescription").value.trim();

    const isler =
        linesToArray(
            document.getElementById("editorEngineeringWork").value
        );

    const dersler =
        linesToArray(
            document.getElementById("editorEngineeringSubjects").value
        );

    const alanlar =
        linesToArray(
            document.getElementById("editorEngineeringFields").value
        );

    const uygun =
        document.getElementById("editorEngineeringSuitable").value.trim();

    const kariyer =
        document.getElementById("editorEngineeringCareer").value.trim();

    const etiket =
        linesToArray(
            document.getElementById("editorEngineeringTags").value
        );

    const salary =
        document.getElementById("editorEngineeringSalary").value.trim();

    const message =
        document.getElementById("engineeringEditorMessage");

    if(!name){

        message.innerHTML =
            "❌ Mühendislik adı gerekli.";

        return;

    }

    const payload = {

        name,
        kisa,
        nedir,
        isler,
        dersler,
        alanlar,
        uygun,
        kariyer,
        etiket,
        description: nedir,
        work: isler,
        education: dersler,
        salary

    };

    try{

        const url =
            id
            ? "/api/admin/engineering/" + encodeURIComponent(id)
            : "/api/admin/engineering";

        const method =
            id ? "PUT" : "POST";

        message.innerHTML =
            "⏳ Kaydediliyor...";

        const response =
            await fetch(url, {

                method,

                credentials:"same-origin",

                headers:{
                    "Content-Type":"application/json"
                },

                body:JSON.stringify(payload)

            });

        const result =
            await response.json();

        if(!response.ok){

            message.innerHTML =
                "❌ " +
                (
                    result.message ||
                    "Kaydedilemedi."
                );

            return;

        }

        message.innerHTML =
            "✅ Kaydedildi ve yayınlandı!";

        await /* Mühendislik editörü kaldırıldı */

        const newId =
            result.id ||
            result.engineering?.id ||
            id;

        if(newId){

            selectEngineeringEditor(newId);

        }

        document.getElementById("engineeringDeleteButton").style.display =
            "";

    }catch(error){

        console.error(error);

        message.innerHTML =
            "❌ Sunucuya bağlanılamadı: " +
            error.message;

    }

}


/* =========================================================
   SİL
========================================================= */

async function deleteEngineeringEditor(){

    const id =
        document.getElementById("editorEngineeringId").value.trim();

    const message =
        document.getElementById("engineeringEditorMessage");

    if(!id){

        message.innerHTML =
            "❌ Önce bir mühendislik seç.";

        return;

    }

    const item =
        engineeringEditorData.find(
            x => Number(x.id) === Number(id)
        );

    const name =
        item?.name ||
        "bu mühendisliği";

    if(!confirm(
        "⚠️ " +
        name +
        " silinsin mi?"
    )){

        return;

    }

    try{

        message.innerHTML =
            "⏳ Siliniyor...";

        const response =
            await fetch(
                "/api/admin/engineering/" +
                encodeURIComponent(id),
                {
                    method:"DELETE",
                    credentials:"same-origin"
                }
            );

        const result =
            await response.json();

        if(!response.ok){

            message.innerHTML =
                "❌ " +
                (
                    result.message ||
                    "Silinemedi."
                );

            return;

        }

        message.innerHTML =
            "✅ Mühendislik silindi.";

        selectedEngineeringId = null;

        await /* Mühendislik editörü kaldırıldı */

        document.getElementById("editorEngineeringId").value = "";

    }catch(error){

        console.error(error);

        message.innerHTML =
            "❌ Sunucuya bağlanılamadı.";

    }

}


/* =========================================================
   HTML GÜVENLİĞİ
========================================================= */

function escapeHtml(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =========================================================
   BAŞLAT
========================================================= */

/* Mühendislik editörü kaldırıldı */

</script>


