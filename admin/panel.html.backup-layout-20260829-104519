<script>

/* SITE KONTROL MERKEZI */

async function kontrolIstatistikleri(){

    try{

        const response=await fetch("/api/admin/stats");
        const data=await response.json();

        const visits=document.getElementById("controlVisits");
        const universities=document.getElementById("controlUniversities");
        const news=document.getElementById("controlNews");

        if(visits) visits.textContent=data.visits ?? 0;
        if(universities) universities.textContent=data.universities ?? 0;
        if(news) news.textContent=data.news ?? 0;

        logYaz("İstatistikler güncellendi.");

    }catch(error){

        logYaz("İstatistikler alınamadı.");

    }

}

function yenileKontrol(){

    kontrolIstatistikleri();

    const el=document.getElementById("systemLog");

    if(el){
        el.textContent="🔄 Sistem verileri yenileniyor...";
    }

    setTimeout(()=>{
        if(el){
            el.textContent="✅ Sistem verileri güncellendi.";
        }
    },700);

}

function duyuruOnizle(){

    const title=document.getElementById("announcementTitle").value.trim();
    const text=document.getElementById("announcementText").value.trim();

    const preview=document.getElementById("announcementPreview");

    if(!title || !text){

        preview.innerHTML=
        '<p style="color:#ef4444 !important">Başlık ve duyuru metni gerekli.</p>';

        return;
    }

    preview.innerHTML=`
        <div class="announcement-preview">
            <h3>📢 ${title}</h3>
            <p>${text}</p>
        </div>
    `;

    logYaz("Duyuru önizlemesi oluşturuldu.");

}

function duyuruTemizle(){

    document.getElementById("announcementTitle").value="";
    document.getElementById("announcementText").value="";
    document.getElementById("announcementPreview").innerHTML="";

    logYaz("Duyuru alanı temizlendi.");

}

function oneCikanKaydet(){

    const value=document.getElementById("featuredEngineering").value;

    localStorage.setItem(
        "featuredEngineering",
        value
    );

    document.getElementById("featuredMessage").textContent=
        "✅ "+value+" öne çıkan olarak kaydedildi.";

    logYaz(value+" öne çıkan mühendislik olarak seçildi.");

}

function siteBilgisiKaydet(){

    const name=document.getElementById("controlSiteName").value;
    const description=document.getElementById("controlSiteDescription").value;

    localStorage.setItem("siteName",name);
    localStorage.setItem("siteDescription",description);

    document.getElementById("siteInfoMessage").textContent=
        "✅ Site bilgileri kaydedildi.";

    logYaz("Site bilgileri kaydedildi.");

}

function logYaz(text){

    const log=document.getElementById("systemLog");

    if(log){
        log.textContent="["+new Date().toLocaleTimeString("tr-TR")+"] "+text;
    }

}

kontrolIstatistikleri();

</script>

<script>

async function loadEngineeringAdmin(){

    const container = document.getElementById("engineeringAdminList");

    if(!container){
        console.error("engineeringAdminList bulunamadı.");
        return;
    }

    container.innerHTML = `
        <div class="news-item">
            ⏳ Mühendislikler yükleniyor...
        </div>
    `;

    try{

        const response = await fetch("/api/engineering");

        if(!response.ok){
            throw new Error("API HTTP " + response.status);
        }

        const data = await response.json();

        console.log("Mühendislik API:", data);

        if(!Array.isArray(data)){
            throw new Error("API dizi döndürmedi.");
        }

        if(data.length === 0){
            container.innerHTML = `
                <div class="news-item">
                    Henüz mühendislik bulunmuyor.
                </div>
            `;
            return;
        }

        container.innerHTML = data.map(item => `

            <div class="news-item engineering-admin-item">

                <h3>
                    ⚙️ ${item.name || "İsimsiz mühendislik"}
                </h3>

                <p>
                    <strong>📖 Açıklama</strong><br>
                    ${item.description || "Bilgi girilmemiş."}
                </p>

                <p>
                    <strong>🛠️ Ne İş Yapar?</strong><br>
                    ${item.work || "Bilgi girilmemiş."}
                </p>

                <p>
                    <strong>🎓 Eğitim</strong><br>
                    ${item.education || "Bilgi girilmemiş."}
                </p>

                <p>
                    <strong>💰 Maaş</strong><br>
                    ${item.salary || "Bilgi girilmemiş."}
                </p>

            </div>

        `).join("");

    }catch(error){

        console.error("Mühendislik yükleme hatası:", error);

        container.innerHTML = `
            <div class="news-item">
                ❌ Mühendislikler yüklenemedi.
                <br><br>
                <small>${error.message}</small>
            </div>
        `;

    }

}

async function addEngineering(){

    const name =
        document.getElementById("engName").value.trim();

    const description =
        document.getElementById("engDescription").value.trim();

    const work =
        document.getElementById("engWork").value.trim();

    const education =
        document.getElementById("engEducation").value.trim();

    const salary =
        document.getElementById("engSalary").value.trim();

    const message =
        document.getElementById("engMessage");

    if(!name){

        message.innerHTML =
            "❌ Mühendislik adı gerekli.";

        return;

    }

    try{

        const response = await fetch(
            "/api/admin/engineering",
            {
                method:"POST",
                headers:{
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    name,
                    description,
                    work,
                    education,
                    salary
                })
            }
        );

        const result =
            await response.json();

        if(!response.ok){

            message.innerHTML =
                "❌ " + (result.message || "Eklenemedi.");

            return;

        }

        message.innerHTML =
            "✅ Mühendislik başarıyla eklendi.";

        document.getElementById("engName").value="";
        document.getElementById("engDescription").value="";
        document.getElementById("engWork").value="";
        document.getElementById("engEducation").value="";
        document.getElementById("engSalary").value="";

        loadEngineeringAdmin();

    }catch(error){

        console.error(error);

        message.innerHTML =
            "❌ Sunucuya bağlanılamadı.";

    }

}

</script>



