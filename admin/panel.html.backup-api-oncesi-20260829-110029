<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mühendislik Merkezi — Admin</title>

<style>
*{box-sizing:border-box}

:root{
    --bg:#070a0f;
    --panel:#0d1219;
    --panel2:#111821;
    --border:#202b38;
    --text:#e8edf3;
    --muted:#7f8b99;
    --accent:#36d399;
    --accent2:#1fa97b;
    --danger:#ff5c6c;
}

body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}

/* LOGIN */
#loginScreen{
    position:fixed;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
        radial-gradient(circle at center,#12201d 0,#070a0f 45%,#040609 100%);
}

.login-box{
    width:min(420px,90%);
    background:rgba(13,18,25,.96);
    border:1px solid var(--border);
    padding:38px;
    border-radius:18px;
    box-shadow:0 25px 80px #000;
}

.logo{
    font-size:15px;
    color:var(--accent);
    letter-spacing:3px;
    font-weight:800;
    margin-bottom:12px;
}

.login-box h1{
    margin:0 0 8px;
    font-size:27px;
}

.login-box p{
    color:var(--muted);
    margin-bottom:28px;
}

input,textarea,select{
    width:100%;
    background:#080c11;
    border:1px solid var(--border);
    color:var(--text);
    padding:12px 14px;
    border-radius:9px;
    outline:none;
    font:inherit;
}

input:focus,textarea:focus,select:focus{
    border-color:var(--accent);
}

.login-box button{
    width:100%;
    margin-top:14px;
    padding:13px;
    border:0;
    border-radius:9px;
    background:var(--accent);
    color:#04110c;
    font-weight:800;
    cursor:pointer;
}

.error{
    color:var(--danger);
    margin-top:12px;
    min-height:20px;
    font-size:13px;
}

/* ADMIN */
#adminApp{
    display:none;
    min-height:100vh;
}

.topbar{
    height:64px;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 25px;
    background:#090d13;
}

.brand{
    font-weight:800;
}

.brand span{
    color:var(--accent);
}

.status{
    color:var(--accent);
    font-size:12px;
}

.layout{
    display:grid;
    grid-template-columns:230px minmax(0,1fr);
    min-height:calc(100vh - 64px);
}

.sidebar{
    border-right:1px solid var(--border);
    background:#090d13;
    padding:18px 12px;
}

.nav-title{
    color:#596575;
    font-size:10px;
    letter-spacing:2px;
    margin:16px 12px 8px;
}

.nav{
    display:block;
    width:100%;
    border:0;
    background:none;
    color:#aeb8c5;
    text-align:left;
    padding:11px 12px;
    border-radius:8px;
    cursor:pointer;
    font:inherit;
    margin-bottom:3px;
}

.nav:hover,.nav.active{
    background:#111a21;
    color:var(--accent);
}

.main{
    padding:28px;
    min-width:0;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.page-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:24px;
}

.page-head h1{
    margin:0;
    font-size:28px;
}

.page-head p{
    color:var(--muted);
    margin:6px 0 0;
}

.cards{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:14px;
}

.card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:13px;
    padding:20px;
}

.card small{
    color:var(--muted);
}

.card strong{
    display:block;
    font-size:27px;
    margin-top:8px;
}

.editor{
    display:grid;
    grid-template-columns:300px minmax(0,1fr);
    gap:18px;
}

.list,.workspace{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
}

.list{
    padding:12px;
}

.list-item{
    padding:12px;
    border-radius:8px;
    cursor:pointer;
    color:#b6c0cb;
}

.list-item:hover,.list-item.active{
    background:#141d25;
    color:var(--accent);
}

.workspace{
    padding:22px;
    min-width:0;
}

.workspace h2{
    margin-top:0;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.field.full{
    grid-column:1/-1;
}

.field label{
    display:block;
    color:#8995a4;
    font-size:12px;
    margin-bottom:6px;
}

textarea{
    min-height:110px;
    resize:vertical;
}

.actions{
    display:flex;
    gap:10px;
    margin-top:20px;
}

.btn{
    border:1px solid var(--border);
    background:#111821;
    color:var(--text);
    padding:11px 16px;
    border-radius:8px;
    cursor:pointer;
}

.btn.primary{
    background:var(--accent);
    color:#04110c;
    border-color:var(--accent);
    font-weight:800;
}

.btn.danger{
    color:#ff7c89;
}

.notice{
    padding:13px 15px;
    border:1px solid var(--border);
    background:#0a1016;
    border-radius:9px;
    color:var(--muted);
    margin-bottom:18px;
}

@media(max-width:900px){
    .layout{grid-template-columns:1fr}
    .sidebar{
        border-right:0;
        border-bottom:1px solid var(--border);
    }
    .cards{grid-template-columns:1fr 1fr}
    .editor{grid-template-columns:1fr}
}

@media(max-width:600px){
    .cards,.form-grid{grid-template-columns:1fr}
    .main{padding:16px}
}
</style>
</head>

<body>

