<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mühendislik Merkezi | Yönetim</title>

<style>
*{box-sizing:border-box}

body{
margin:0;
font-family:Arial,sans-serif;
background:#070b14;
color:#eef2ff;
}

.layout{
display:flex;
min-height:100vh;
}

.sidebar{
width:250px;
background:#0d1424;
border-right:1px solid #202b40;
padding:22px 14px;
}

.logo{
font-size:21px;
font-weight:bold;
padding:10px 12px 28px;
}

.logo span{
color:#3b82f6;
}

.menu button{
width:100%;
padding:13px;
margin:4px 0;
border:0;
border-radius:10px;
background:transparent;
color:#9eabc2;
text-align:left;
cursor:pointer;
font-size:14px;
}

.menu button:hover,
.menu button.active{
background:#17243b;
color:white;
}

.main{
flex:1;
padding:30px;
}

.header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:28px;
}

.header h1{
margin:0;
font-size:28px;
}

.status{
padding:8px 13px;
border-radius:20px;
background:#123525;
color:#61e59a;
font-size:13px;
}

.page{
display:none;
}

.page.active{
display:block;
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px;
}

.card{
background:#0d1424;
border:1px solid #202b40;
border-radius:16px;
padding:22px;
}

.icon{
font-size:25px;
}

.label{
color:#8997ae;
margin-top:10px;
}

.number{
font-size:30px;
font-weight:bold;
margin-top:8px;
}

.panel{
margin-top:22px;
}

.panel h2{
margin-top:0;
}

table{
width:100%;
border-collapse:collapse;
}

th,td{
padding:14px;
border-bottom:1px solid #202b40;
text-align:left;
}

th{
color:#8997ae;
font-size:13px;
}

input,select,textarea{
width:100%;
padding:12px;
margin:7px 0 15px;
background:#080e1a;
border:1px solid #2a3852;
border-radius:9px;
color:white;
}

.btn{
padding:11px 17px;
border:0;
border-radius:9px;
background:#2563eb;
color:white;
cursor:pointer;
}

.btn:hover{
background:#1d4ed8;
}

.grid2{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

@media(max-width:900px){
.sidebar{width:190px}
.cards{grid-template-columns:1fr 1fr}
.grid2{grid-template-columns:1fr}
}
</style>

<style>

/* SITE KONTROL MERKEZI */

.control-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-top:20px;
}

.control-box{
    background:#111a2d;
    border:1px solid #293956;
    border-radius:14px;
    padding:20px;
}

.control-box strong{
    display:block;
    color:#172033;
    font-size:16px;
    margin-bottom:10px;
}

.status-ok{
    color:#16834b !important;
    font-weight:700;
}

.quick-links{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
    margin-top:18px;
}

.quick-link{
    display:block;
    padding:15px;
    border-radius:12px;
    background:#17223a;
    color:#ffffff !important;
    text-decoration:none;
    font-weight:700;
    transition:.2s;
}

.quick-link:hover{
    background:#287cff;
    transform:translateY(-2px);
}

@media(max-width:900px){
    .control-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .quick-links{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){
    .control-grid,
    .quick-links{
        grid-template-columns:1fr;
    }
}

</style>
</head>

<body>

<div class="layout">

<aside class="sidebar">

<div class="logo">
Mühendislik <span>Merkezi</span>
</div>

<div class="menu">

<button class="active" onclick="show('dashboard',this)">📊 Dashboard</button>

<button onclick="show('analytics',this)">📈 Analiz</button>

<button onclick="show('universities',this)">🏫 Üniversiteler</button>

<button onclick="show('engineering',this)">⚙️ Mühendislikler</button>

<button onclick="show('news',this)">📰 Haberler</button>

<button onclick="show('yks',this)">📝 YKS Yönetimi</button>

<button onclick="show('users',this)">👥 Kullanıcılar</button>

<button onclick="show('settings',this)">⚙️ Site Ayarları</button>

<button onclick="show('security',this)">🔐 Güvenlik</button>

</div>

</aside>

<main class="main">

<div class="header">

<h1>Dashboard</h1>

<div class="status">● Sistem Aktif</div>

</div>

<section id="dashboard" class="page active">

<div class="cards">

<div class="card">
<div class="icon">👥</div>
<div class="label">Toplam Ziyaretçi</div>
<div class="number" id="visits">0</div>
</div>

<div class="card">
<div class="icon">🏫</div>
<div class="label">Üniversite</div>
<div class="number" id="universitiesCount">0</div>
</div>

<div class="card">
<div class="icon">⚙️</div>
<div class="label">Mühendislik</div>
<div class="number">20+</div>
</div>

<div class="card">
<div class="icon">📰</div>
<div class="label">Haber</div>
<div class="number" id="newsCount">0</div>
</div>

</div>

<div class="card panel">

<h2>Hızlı Yönetim</h2>

<p>Site verilerini sol menüden yönetebilirsin.</p>

</div>

</section>


<section id="analytics" class="page">

<h1>📈 Analiz</h1>

<div class="grid2">

<div class="card">
<h2>Ziyaretçi Analizi</h2>
<p>Toplam ziyaretçi: <b id="analyticsVisits">0</b></p>
<p>Sunucu durumu: <b>Aktif</b></p>
</div>

<div class="card">
<h2>Site Durumu</h2>
<p>API: Aktif</p>
<p>Veritabanı: Aktif</p>
</div>

</div>

</section>


<section id="universities" class="page">

<h1>🏫 Üniversite Yönetimi</h1>

<div class="card panel">

<label>Üniversite adı</label>
<input placeholder="Örn. Erciyes Üniversitesi">

<label>Bölüm</label>
<input placeholder="Bilgisayar Mühendisliği">

<label>Şehir</label>
<input placeholder="Kayseri">

<label>Taban puan</label>
<input placeholder="Örn. 450.25">

<label>Başarı sırası</label>
<input placeholder="Örn. 35.000">

<label>Kontenjan</label>
<input placeholder="Örn. 80">

<button class="btn">Üniversite Ekle</button>

</div>

</section>


<section id="engineering" class="page">

<h1>⚙️ Mühendislik Yönetimi</h1>

<div class="card panel">

<label>Mühendislik adı</label>
<input placeholder="Bilgisayar Mühendisliği">

<label>Açıklama</label>
<textarea rows="7" placeholder="Bölüm hakkında bilgi..."></textarea>

<label>İş olanakları</label>
<textarea rows="5" placeholder="Çalışma alanları..."></textarea>

<button class="btn">Mühendislik Ekle</button>

</div>

</section>



<section id="news" class="page">
<style>
.news-admin-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}
.news-editor{
    background:#111827;
    border:1px solid #334155;
    border-radius:18px;
    padding:22px;
}
.news-editor h2{
    margin-top:0;
}
.news-editor input,
.news-editor textarea{
    width:100%;
    padding:13px;
    margin:7px 0 14px;
    border-radius:10px;
    border:1px solid #475569;
    background:#0b1020;
    color:white;
}
.news-editor textarea{
    min-height:140px;
    resize:vertical;
}
.news-actions{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}
.news-list{
    margin-top:25px;
    display:grid;
    gap:14px;
}
.news-item{
    background:#111827;
    border:1px solid #334155;
    border-radius:15px;
    padding:18px;
}
.news-item h3{
    margin:5px 0 8px;
}
.news-date{
    color:#60a5fa;
    font-size:13px;
}
.news-item p{
    color:#cbd5e1;
    line-height:1.6;
}
.news-item button{
    border:0;
    border-radius:8px;
    padding:9px 13px;
    cursor:pointer;
    margin-right:7px;
}
.edit-btn{background:#2563eb;color:white}
.delete-btn{background:#dc2626;color:white}

@media(max-width:800px){
    .news-admin-grid{
        grid-template-columns:1fr;
    }
}
</style>

<h1>📰 Haber Yönetimi</h1>
<p class="muted">
Sitedeki haberleri buradan oluştur, düzenle ve yayınla.
</p>

<div class="news-admin-grid">

<div class="news-editor">
<h2>🚀 Yeni Haber Yayınla</h2>

<label>Haber başlığı</label>
<input id="newsTitle" placeholder="Örn. 2026-YKS yerleştirme sonuçları açıklandı">

<label>Haber içeriği</label>
<textarea id="newsText"
placeholder="Haberin açıklamasını buraya yaz..."></textarea>

<div class="news-actions">
<button class="primary" onclick="publishNews()">
🚀 Haber Yayınla
</button>

<button onclick="clearNewsForm()">
Temizle
</button>
</div>
</div>

<div class="news-editor">
<h2>📊 Haber Merkezi</h2>
<div class="stat" id="adminNewsCount">0</div>
<div class="muted">Yayınlanmış haber</div>

<hr style="border-color:#334155;margin:22px 0">

<p class="muted">
Yeni haber yayınladığında normal sitenin
<strong>Haberler ve Duyurular</strong> bölümünde otomatik görünür.
</p>
</div>

</div>

<div class="news-list" id="adminNewsList">
<div class="news-item">
Haberler yükleniyor...
</div>
</div>
</section>



<section id="yks" class="page">

<h1>📝 YKS Yönetimi</h1>

<div class="grid2">

<div class="card">

<h2>TYT</h2>

<label>Türkçe</label>
<input type="number" value="40">

<label>Sosyal Bilimler</label>
<input type="number" value="20">

<label>Temel Matematik</label>
<input type="number" value="40">

<label>Fen Bilimleri</label>
<input type="number" value="20">

</div>

<div class="card">

<h2>Net Hesaplama</h2>

<label>Yanlış başına götürülen net</label>

<input type="number" value="0.25" step="0.01">

<button class="btn">YKS Ayarlarını Kaydet</button>

</div>

</div>

</section>


<section id="users" class="page">

<h1>🛠️ Site Kontrol Merkezi</h1>

<div class="card panel">

<h2>📊 Sistem Durumu</h2>

<div class="control-grid">

<div class="control-box">
<strong>🌐 Ana Site</strong>
<span class="status-ok">● Çalışıyor</span>
</div>

<div class="control-box">
<strong>⚙️ API</strong>
<span class="status-ok">● Aktif</span>
</div>

<div class="control-box">
<strong>📰 Haber Sistemi</strong>
<span class="status-ok">● Aktif</span>
</div>

<div class="control-box">
<strong>📝 YKS Sistemi</strong>
<span class="status-ok">● Aktif</span>
</div>

</div>

</div>

<div class="card panel">

<h2>🔗 Hızlı Erişim</h2>

<div class="quick-links">

<a href="/" target="_blank" class="quick-link">
🌐 Ana Site
</a>

<a href="/#muhendislik" target="_blank" class="quick-link">
⚙️ Mühendislikler
</a>

<a href="/#universite" target="_blank" class="quick-link">
🎓 Üniversiteler
</a>

<a href="/#yks" target="_blank" class="quick-link">
📝 YKS
</a>

<a href="/#haberler" target="_blank" class="quick-link">
📰 Haberler
</a>

</div>

</div>

<div class="card panel">

<h2>🔐 Yönetici Bilgileri</h2>

<p class="muted">
Yönetici hesabı ve güvenlik ayarları Güvenlik bölümünden yönetilir.
</p>

<button class="btn" onclick="show('security',document.querySelector('[onclick*=security]'))">
🔐 Güvenlik Ayarlarına Git
</button>

</div>

</section>


<section id="settings" class="page">

<h1>⚙️ Site Ayarları</h1>

<div class="card panel">

<label>Site adı</label>
<input value="Mühendislik Merkezi">

<label>Site açıklaması</label>

<textarea rows="5">Üniversite, YKS ve mühendislik kariyerinin merkezi.</textarea>

<button class="btn">Ayarları Kaydet</button>

</div>

</section>


<section id="security" class="page">

<h1>🔐 Güvenlik</h1>

<div class="card panel">

<h2>Admin Hesabı</h2>

<p>Admin hesabının güvenlik ayarları.</p>

<label>Yeni admin şifresi</label>

<input type="password" placeholder="Yeni şifre">

<button class="btn">Şifreyi Güncelle</button>

</div>

</section>

</main>

</div>

<script>

function show(id,button){

document.querySelectorAll(".page")
.forEach(x=>x.classList.remove("active"));

document.getElementById(id)
.classList.add("active");

document.querySelectorAll(".menu button")
.forEach(x=>x.classList.remove("active"));

button.classList.add("active");

}

fetch("/api/admin/stats")
.then(r=>r.json())
.then(d=>{

if(d.visits!==undefined){

document.getElementById("visits").textContent=d.visits;

document.getElementById("analyticsVisits").textContent=d.visits;

}

if(d.universities!==undefined){

document.getElementById("universitiesCount").textContent=d.universities;

}

if(d.news!==undefined){

document.getElementById("newsCount").textContent=d.news;

}

})
.catch(()=>{});

</script>

</body>
</html>

<script>
async function loadAdminNews(){

    const list = document.getElementById("adminNewsList");
    const count = document.getElementById("adminNewsCount");

    try{

        const response = await fetch("/api/news");
        const news = await response.json();

        count.textContent = news.length;

        if(!news.length){
            list.innerHTML = `
                <div class="news-item">
                    <h3>Henüz haber yok</h3>
                    <p>Yukarıdaki formdan ilk haberi yayınlayabilirsin.</p>
                </div>
            `;
            return;
        }

        list.innerHTML = news.map(item => {

            const date = new Date(item.created_at);

            return `
                <div class="news-item">

                    <div class="news-date">
                        ${date.toLocaleDateString("tr-TR")}
                    </div>

                    <h3>${escapeNews(item.title)}</h3>

                    <p>${escapeNews(item.text)}</p>

                    <button
                        class="edit-btn"
                        onclick="editNews(
                            ${item.id},
                            ${JSON.stringify(item.title)},
                            ${JSON.stringify(item.text)}
                        )">
                        ✏️ Düzenle
                    </button>

                    <button
                        class="delete-btn"
                        onclick="deleteNews(${item.id})">
                        🗑️ Sil
                    </button>

                </div>
            `;

        }).join("");

    }catch(error){

        console.error(error);

        list.innerHTML = `
            <div class="news-item">
                <h3>⚠️ Haberler yüklenemedi</h3>
                <p>Sunucu bağlantısını kontrol et.</p>
            </div>
        `;
    }
}


async function publishNews(){

    const title =
        document.getElementById("newsTitle").value.trim();

    const text =
        document.getElementById("newsText").value.trim();

    if(!title || !text){

        alert("Başlık ve haber içeriğini doldur.");

        return;
    }

    try{

        const response = await fetch("/api/admin/news",{

            method:"POST",

            headers:{
                "Content-Type":"application/json"
            },

            body:JSON.stringify({
                title:title,
                text:text
            })

        });

        const result = await response.json();

        if(!result.success){

            alert(result.message || "Haber yayınlanamadı.");

            return;
        }

        alert("✅ Haber başarıyla yayınlandı!");

        clearNewsForm();

        loadAdminNews();

    }catch(error){

        console.error(error);

        alert("❌ Sunucuya bağlanılamadı.");
    }
}


async function deleteNews(id){

    if(!confirm("Bu haberi silmek istediğine emin misin?")){

        return;
    }

    try{

        const response = await fetch(
            "/api/admin/news/" + id,
            {
                method:"DELETE"
            }
        );

        const result = await response.json();

        if(result.success){

            loadAdminNews();

        }else{

            alert(result.message || "Haber silinemedi.");
        }

    }catch(error){

        alert("Sunucuya bağlanılamadı.");
    }
}


function editNews(id,title,text){

    document.getElementById("newsTitle").value = title;

    document.getElementById("newsText").value = text;

    const button =
        document.querySelector(
            '#news .primary'
        );

    button.textContent = "💾 Haberi Güncelle";

    button.onclick = async function(){

        try{

            const response = await fetch(
                "/api/admin/news/" + id,
                {
                    method:"PUT",

                    headers:{
                        "Content-Type":"application/json"
                    },

                    body:JSON.stringify({
                        title:
                            document.getElementById("newsTitle").value.trim(),

                        text:
                            document.getElementById("newsText").value.trim()
                    })
                }
            );

            const result = await response.json();

            if(result.success){

                alert("✅ Haber güncellendi!");

                clearNewsForm();

                loadAdminNews();

            }else{

                alert(result.message || "Güncelleme başarısız.");
            }

        }catch(error){

            alert("Sunucuya bağlanılamadı.");
        }

    };

    document
        .getElementById("newsTitle")
        .focus();
}


function clearNewsForm(){

    document.getElementById("newsTitle").value = "";

    document.getElementById("newsText").value = "";

    const button =
        document.querySelector(
            '#news .primary'
        );

    button.textContent = "🚀 Haber Yayınla";

    button.onclick = publishNews;
}


function escapeNews(value){

    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}


loadAdminNews();
</script>

