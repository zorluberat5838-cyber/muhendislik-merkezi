            .textContent = data.universities;

        document.getElementById("contentCount")
            .textContent = data.content;

    }catch(error){

        console.log(error);

    }

}


async function registerVisit(){

    let visitorId =
        localStorage.getItem("visitor_id");

    if(!visitorId){

        visitorId =
            crypto.randomUUID();

        localStorage.setItem(
            "visitor_id",
            visitorId
        );

    }

    try{

        await fetch("/api/visit",{

            method:"POST",

            headers:{
                "Content-Type":
                "application/json"
            },

            body:JSON.stringify({
                visitor_id:visitorId
            })

        });

    }catch(error){

        console.log(error);

    }

}


function searchSite(){

    const value =
        document
        .getElementById("searchInput")
        .value
        .toLowerCase()
        .trim();

    if(!value){

        alert("Aramak istediğin şeyi yaz.");

        return;

    }

    const elements =
        document.querySelectorAll(
            ".eng,.category,.news-card"
        );

    let found = false;

    elements.forEach(element=>{

        if(
            element.innerText
            .toLowerCase()
            .includes(value)
        ){

            element.scrollIntoView({
                behavior:"smooth",
                block:"center"
            });

            element.style.outline =
                "3px solid #2563eb";

            setTimeout(()=>{

                element.style.outline = "";

            },2000);

            found = true;

        }

    });

    if(!found){

        alert(
            `"${value}" için sonuç bulunamadı.`
        );

    }

}


async function loadNews(){

    try{

        const response =
            await fetch("/api/news");

        const news =
            await response.json();

        if(!news.length)
            return;

        const container =
            document.getElementById(
                "newsContainer"
            );

        container.innerHTML = "";

        news.forEach(item=>{

            const card =
                document.createElement("div");

            card.className =
                "news-card";

            card.innerHTML = `

                <small>${item.source || "HABER"}</small>

                <h3>${item.title}</h3>

                <p>${item.text || ""}</p>

                ${
                    item.url
                    ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer"
                         style="display:inline-block;margin-top:10px;color:#4da3ff;font-weight:700;text-decoration:none">
                         Haberin tamamını MEB'de görüntüle →
                       </a>`
                    : ""
                }

            `;

            container.appendChild(card);

        });

    }catch(error){

        console.log(error);

    }

}


registerVisit();
loadStats();
loadNews();

</script>


<script>
function kesfetAra(deger){
    const sonuc=document.getElementById("kesfetSonuc");
    const q=(deger||"").trim().toLocaleLowerCase("tr-TR");

    if(!q){
        sonuc.innerHTML="";
        return;
    }

    const liste=typeof engineeringList !== "undefined"
        ? engineeringList
        : [];

    const bulunan=liste.filter(x =>
        x[0].toLocaleLowerCase("tr-TR").includes(q) ||
        x[1].toLocaleLowerCase("tr-TR").includes(q)
    );

    if(!bulunan.length){
        sonuc.innerHTML="❌ Sonuç bulunamadı.";
        return;
    }

    sonuc.innerHTML=bulunan.slice(0,6).map(x=>`
        <div onclick="muhendislikAc('${x[0].replace(/'/g,"\\'") }')"
             style="padding:14px;margin-top:8px;background:#17223a;border:1px solid #2b3b5d;border-radius:10px;cursor:pointer">
            <strong style="color:#fff">${x[0]}</strong><br>
            <small style="color:#c4cee0">${x[1]}</small>
        </div>
    `).join("");
}

function bolumeGit(id){
    const hedef=document.getElementById(id);

    if(!hedef) return;

    hedef.scrollIntoView({
        behavior:"smooth",
        block:"start"
    });
}

function muhendislikAc(ad){
    bolumeGit("muhendislik");

    setTimeout(()=>{
        const kartlar=document.querySelectorAll(".engineering .eng,.engineering > div");

        kartlar.forEach(k=>{
            if(k.innerText && k.innerText.includes(ad)){
                k.scrollIntoView({
                    behavior:"smooth",
                    block:"center"
                });

                k.style.outline="3px solid #4da3ff";

                setTimeout(()=>{
                    k.style.outline="";
                },2000);
            }
        });
    },500);
}

function gununMuhendisligi(){
    bolumeGit("muhendislik");
}

function muhendislikKarsilastir(){
    bolumeGit("muhendislik");
}

function universiteKesfet(){
    bolumeGit("universite");
}

function yksHedef(){
    bolumeGit("yks");
}
</script>



