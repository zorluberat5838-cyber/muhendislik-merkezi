<script>
function showYks(id,btn){
document.querySelectorAll('.yks-panel').forEach(x=>x.classList.remove('active'));
document.getElementById(id).classList.add('active');
document.querySelectorAll('.yks-tabs button').forEach(x=>x.classList.remove('active'));
btn.classList.add('active');
}

function showAyt(id,btn){
document.querySelectorAll('.ayt-area').forEach(x=>x.style.display='none');
document.getElementById(id).style.display='block';
document.querySelectorAll('.ayt-tabs button').forEach(x=>x.classList.remove('active'));
btn.classList.add('active');
}

function calculateYks(){
document.querySelectorAll('.yks-table tr[data-total]').forEach(row=>{
let total=Number(row.dataset.total);
let d=Math.max(0,Number(row.querySelector('.correct').value)||0);
let y=Math.max(0,Number(row.querySelector('.wrong').value)||0);

if(d+y>total){
y=Math.max(0,total-d);
row.querySelector('.wrong').value=y;
}

let b=Math.max(0,total-d-y);
let n=d-y/4;

row.querySelector('.blank').textContent=b;
row.querySelector('.net').textContent=n.toFixed(2);
});

let td=0,ty=0,tb=0,tn=0;
document.querySelectorAll('#tyt tr[data-total]').forEach(row=>{
td+=Number(row.querySelector('.correct').value)||0;
ty+=Number(row.querySelector('.wrong').value)||0;
tb+=Number(row.querySelector('.blank').textContent)||0;
tn+=Number(row.querySelector('.net').textContent)||0;
});

document.getElementById('tytD').textContent=td;
document.getElementById('tytY').textContent=ty;
document.getElementById('tytB').textContent=tb;
document.getElementById('tytN').textContent=tn.toFixed(2);
}

document.querySelectorAll('.correct,.wrong').forEach(input=>{
input.type='number';
input.min=0;

const row=input.closest('tr');
if(row && row.dataset.total){
    input.max=row.dataset.total;
}

input.addEventListener('input',calculateYks);
});
</script>
