<script id="MM-LIVE-EDITOR-SCRIPT">

(function(){

    const editor =
        document.getElementById(
            "MM-LIVE-EDITOR"
        );

    if(!editor) return;


    let selectedElement = null;

    let history = [];

    let historyIndex = -1;


    function pushHistory(){

        if(!selectedElement) return;

        const snapshot = {
            element:selectedElement,
            html:selectedElement.innerHTML
        };

        history =
            history.slice(
                0,
                historyIndex + 1
            );

        history.push(snapshot);

        historyIndex =
            history.length - 1;
    }


    function selectElement(element){

        if(!element) return;

        if(
            element.closest &&
            element.closest("#MM-LIVE-EDITOR")
        ){
            return;
        }

        if(selectedElement){
            selectedElement.classList.remove(
                "mm-editor-selected"
            );
        }

        selectedElement = element;

        selectedElement.classList.add(
            "mm-editor-selected"
        );


        const toolbox =
            document.getElementById(
                "MM-EDITOR-TOOLBOX"
            );

        const name =
            document.getElementById(
                "mm-selected-name"
            );

        const text =
            document.getElementById(
                "mm-text-editor"
            );


        toolbox.style.display = "block";

        name.textContent =
            element.tagName.toLowerCase();


        text.value =
            element.innerText || "";
    }


    document.addEventListener(
        "click",
        function(e){

            if(
                !document.body.classList.contains(
                    "MM-editor-active"
                )
            ){
                return;
            }


            if(
                e.target.closest &&
                e.target.closest(
                    "#MM-LIVE-EDITOR"
                )
            ){
                return;
            }


            const element =
                e.target;


            if(
                [
                    "SCRIPT",
                    "STYLE",
                    "HTML",
                    "BODY"
                ].includes(
                    element.tagName
                )
            ){
                return;
            }


            e.preventDefault();
            e.stopPropagation();


            selectElement(element);

        },
        true
    );


    document
        .getElementById("mm-apply-text")
        .addEventListener(
            "click",
            function(){

                if(!selectedElement) return;

                pushHistory();

                selectedElement.innerText =
                    document.getElementById(
                        "mm-text-editor"
                    ).value;

            }
        );


    document
        .getElementById("mm-close-toolbox")
        .addEventListener(
            "click",
            function(){

                document.getElementById(
                    "MM-EDITOR-TOOLBOX"
                ).style.display = "none";

                if(selectedElement){

                    selectedElement.classList.remove(
                        "mm-editor-selected"
                    );

                }

                selectedElement = null;

            }
        );


    document
        .getElementById("mm-editor-undo")
        .addEventListener(
            "click",
            function(){

                if(historyIndex < 0) return;

                const item =
                    history[historyIndex];

                item.element.innerHTML =
                    item.html;

                historyIndex--;

            }
        );


    document
        .getElementById("mm-editor-redo")
        .addEventListener(
            "click",
            function(){

                if(
                    historyIndex + 1 >=
                    history.length
                ){
                    return;
                }

                historyIndex++;

                const item =
                    history[historyIndex];

                item.element.innerHTML =
                    item.html;

            }
        );


    document
        .getElementById("mm-editor-cancel")
        .addEventListener(
            "click",
            function(){

                location.reload();

            }
        );


    document
        .getElementById("mm-editor-save")
        .addEventListener(
            "click",
            async function(){

                if(!selectedElement){

                    alert(
                        "Önce sitede değiştirmek istediğin bir öğeye tıkla."
                    );

                    return;
                }


                const text =
                    selectedElement.innerText;


                try{

                    const response =
                        await fetch(
                            "/api/admin/customization",
                            {
                                method:"PUT",
                                headers:{
                                    "Content-Type":
                                        "application/json"
                                },
                                body:JSON.stringify({

                                    hero_text:text

                                })
                            }
                        );


                    const data =
                        await response.json();


                    if(data.success){

                        alert(
                            "✓ Değişiklik yayınlandı!"
                        );

                    }else{

                        alert(
                            data.message ||
                            "Kaydedilemedi."
                        );

                    }

                }catch(error){

                    console.error(error);

                    alert(
                        "Sunucuya bağlanılamadı."
                    );

                }

            }
        );


    /*
     * Editör modu yalnızca URL'de
     * ?editor=1 varsa açılır.
     *
     * Böylece normal site ziyaretçileri
     * editör panelini görmez.
     */

    const params =
        new URLSearchParams(
            window.location.search
        );


    if(
        params.get("editor") === "1"
    ){

        document.body.classList.add(
            "MM-editor-active"
        );

    }else{

        editor.style.display = "none";

    }

})();



