// ==================== ADMİN VERİLERİNİ ANA SİTEYE AKTAR ====================

(async function(){

    try {

        const response = await fetch("/api/engineering", {
            credentials: "same-origin"
        });

        if (!response.ok) return;

        const data = await response.json();

        data.forEach(item => {

            if (!item.name) return;

            // Veritabanındaki güncel bilgiler ana sitedeki
            // varsayılan bilgilerle birleştirilir.
            if (muhendislikDetaylari[item.name]) {

                Object.assign(
                    muhendislikDetaylari[item.name],
                    {
                        kisa: item.kisa || muhendislikDetaylari[item.name].kisa,
                        nedir: item.nedir || muhendislikDetaylari[item.name].nedir,
                        isler: item.isler?.length ? item.isler : muhendislikDetaylari[item.name].isler,
                        dersler: item.dersler?.length ? item.dersler : muhendislikDetaylari[item.name].dersler,
                        alanlar: item.alanlar?.length ? item.alanlar : muhendislikDetaylari[item.name].alanlar,
                        uygun: item.uygun || muhendislikDetaylari[item.name].uygun,
                        kariyer: item.kariyer || muhendislikDetaylari[item.name].kariyer,
                        etiket: item.etiket?.length ? item.etiket : muhendislikDetaylari[item.name].etiket
                    }
                );

            }

        });

    } catch(error) {

        console.warn("Mühendislik verileri alınamadı:", error);

    }

})();


function muhListe(id, liste){

    const el=document.getElementById(id);

    if(!el) return;

    el.innerHTML="";

    liste.forEach(x=>{

        const li=document.createElement("li");

        li.textContent=x;

        el.appendChild(li);

    });

}

function muhDetayAc(ad){

    const veri=muhendislikDetaylari[ad];

    if(!veri){

        console.log("Detay bulunamadı:",ad);

        return;

    }

    document.getElementById("muhDetayBaslik").textContent=ad;
    document.getElementById("muhDetayKisa").textContent=veri.kisa;
    document.getElementById("muhNedir").textContent=veri.nedir;
    document.getElementById("muhUygun").textContent=veri.uygun;
    document.getElementById("muhKariyer").textContent=veri.kariyer;

    muhListe("muhIsler",veri.isler);
    muhListe("muhDersler",veri.dersler);
    muhListe("muhAlanlar",veri.alanlar);

    const etiket=document.getElementById("muhEtiketler");

    etiket.innerHTML="";

    veri.etiket.forEach(x=>{

        const span=document.createElement("span");

        span.className="muh-etiket";
        span.textContent=x;

        etiket.appendChild(span);

    });

    document
        .getElementById("muhDetayOverlay")
        .classList.add("active");

    document.body.style.overflow="hidden";

}

function muhDetayKapat(){

    document
        .getElementById("muhDetayOverlay")
        .classList.remove("active");

    document.body.style.overflow="";

}

document.addEventListener("click",function(e){

    const kart=e.target.closest(
        "#muhendislik .engineering > div, #muhendislik .engineering .engineering-card, #muhendislik .engineering .eng-card"
    );

    if(!kart) return;

    const baslik=kart.querySelector("h3");

    if(!baslik) return;

    const ad=baslik.textContent.trim();

    if(muhendislikDetaylari[ad]){
        muhDetayAc(ad);
    }

});

document.getElementById("muhDetayOverlay")
.addEventListener("click",function(e){

    if(e.target===this){
        muhDetayKapat();
    }

});

document.addEventListener("keydown",function(e){

    if(e.key==="Escape"){
        muhDetayKapat();
    }

});

