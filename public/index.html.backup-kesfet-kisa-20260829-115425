============================================================ */

async function adminMühendislikleriniYükle(){

    try{

        const response =
            await fetch("/api/engineering", {
                cache:"no-store"
            });

        if(!response.ok) return;

        const liste =
            await response.json();

        if(!Array.isArray(liste)) return;


        /*
         * Veritabanındaki mühendislik bilgileri,
         * sabit varsayılan bilgilerin üzerine yazılır.
         */

        liste.forEach(item => {

            const ad =
                String(item.name || "").trim();

            if(!ad) return;


            /*
             * Eski detay sistemi varsa onu koruyoruz.
             * Sadece admin panelinden düzenlenen alanları
             * değiştiriyoruz.
             */

            if(!muhendislikDetaylari[ad]){

                muhendislikDetaylari[ad] = {

                    kisa:
                        item.description || "",

                    nedir:
                        item.description || "",

                    isler:
                        item.work
                        ? item.work
                            .split(/\r?\n/)
                            .map(x=>x.trim())
                            .filter(Boolean)
                        : [],

                    dersler:
                        item.education
                        ? item.education
                            .split(/\r?\n/)
                            .map(x=>x.trim())
                            .filter(Boolean)
                        : [],

                    alanlar:[],

                    uygun:"",

                    kariyer:
                        item.education || "",

                    etiket:[]

                };

            }else{

                /*
                 * Mevcut detay sayfasını bozmadan
                 * admin verilerini üzerine uyguluyoruz.
                 */

                if(item.description){

                    muhendislikDetaylari[ad].kisa =
                        item.description;

                    muhendislikDetaylari[ad].nedir =
                        item.description;

                }


                if(item.work){

                    muhendislikDetaylari[ad].isler =
                        item.work
                            .split(/\r?\n/)
                            .map(x=>x.trim())
                            .filter(Boolean);

                }


                if(item.education){

                    muhendislikDetaylari[ad].kariyer =
                        item.education;

                    muhendislikDetaylari[ad].dersler =
                        item.education
                            .split(/\r?\n/)
                            .map(x=>x.trim())
                            .filter(Boolean);

                }

            }

            /*
             * Maaş bilgisini ayrıca saklıyoruz.
             * Eğer detay kartında maaş alanı varsa
             * buradan okuyabilir.
             */

            muhendislikDetaylari[ad].maaş =
                item.salary || "";

        });


        /*
         * Sayfa zaten mühendislikleri oluşturduysa
         * yeniden çizmek için varsa ilgili fonksiyonları çağır.
         */

        if(typeof muhendislikleriYukle === "function"){

            try{
                muhendislikleriYukle();
            }catch(e){}

        }

        if(typeof renderEngineering === "function"){

            try{
                renderEngineering();
            }catch(e){}

        }

    }catch(error){

        console.log(
            "Admin mühendislik verileri alınamadı:",
            error
        );

    }

}


/*
 * Varsayılan detaylar tanımlandıktan sonra
 * veritabanındaki düzenlemeleri uygula.
 */

setTimeout(
    adminMühendislikleriniYükle,
    100
);


</script>



<script id="mega-stats-script">
(function(){

    function getVisitorId(){
        let id = localStorage.getItem("mm_visitor_id");

        if(!id){
            id =
                (window.crypto && crypto.randomUUID)
                ? crypto.randomUUID()
                : "v_" + Date.now() + "_" + Math.random().toString(36).slice(2);

            localStorage.setItem("mm_visitor_id", id);
        }

        return id;
    }

    async function trackVisit(){
        try{
            await fetch(
                "/api/track-visit?id=" +
                encodeURIComponent(getVisitorId())
            );
        }catch(error){
            console.warn("Ziyaretçi takibi yapılamadı.", error);
        }
    }

    function animateNumber(el, value){
        if(!el) return;

        const end = Number(value) || 0;
        const start = Number(el.dataset.current || 0);
        const duration = 650;
        const started = performance.now();

        function step(now){
            const progress = Math.min((now-started)/duration, 1);
            const current = Math.round(
                start + (end-start) * progress
            );

            el.textContent =
                current.toLocaleString("tr-TR");

            if(progress < 1){
                requestAnimationFrame(step);
            }else{
                el.dataset.current = String(end);
            }
        }

        requestAnimationFrame(step);
    }

    async function loadSiteStats(){
        try{
            const response = await fetch(
                "/api/site-stats",
                { cache:"no-store" }
            );

            if(!response.ok){
                throw new Error("İstatistik API hatası");
            }

            const data = await response.json();

            animateNumber(
                document.getElementById("statTotalVisitors"),
                data.totalVisitors
            );

            animateNumber(
                document.getElementById("statTodayVisitors"),
                data.todayVisitors
            );

            animateNumber(
                document.getElementById("statEngineering"),
                data.engineeringCount
            );

            animateNumber(
                document.getElementById("statSalary"),
                data.salaryCount
            );

            animateNumber(
                document.getElementById("statNews"),
                data.newsCount
            );

            animateNumber(
                document.getElementById("statContent"),
                data.contentCount
            );

        }catch(error){
            console.warn("İstatistikler yüklenemedi:", error);
        }
    }

    document.addEventListener("DOMContentLoaded", async function(){
        await trackVisit();
        await loadSiteStats();

        setInterval(loadSiteStats, 60000);
    });

})();
</script>


<script>
/*
============================================================
MÜHENDİSLİK MERKEZİ — CANLI ADMIN SENKRONİZASYONU
============================================================
Admin panelindeki değişiklikleri ana siteye getirir.
============================================================
*/

(async function canlıSiteSenkronizasyonu() {

    try {

        const response = await fetch(
            "/api/site-data?_=" + Date.now(),
            {
                cache: "no-store",
                headers: {
                    "Cache-Control": "no-cache"
                }
            }
        );

        if (!response.ok) {
            console.warn("Canlı site verisi alınamadı.");
            return;
        }

        const data = await response.json();

        if (!data.success) {
            console.warn("Site data başarısız.");
            return;
        }

        window.MUHENDISLIK_MERKEZI_DATA = data;

        const settings = data.settings || {};

        /*
        --------------------------------------------------------
        SITE AYARLARI
        --------------------------------------------------------
        */

        if (settings.site_name) {

            document
                .querySelectorAll(
                    ".site-name, [data-site-name], .logo-text"
                )
                .forEach(el => {
                    el.textContent = settings.site_name;
                });

            if (
                document.title &&
                document.title.includes("Mühendislik")
            ) {
                document.title =
                    settings.site_name + " — Mühendislik ve Kariyer";
            }
        }

        if (settings.site_description) {

            document
                .querySelectorAll(
                    "[data-site-description], .site-description"
                )
                .forEach(el => {
                    el.textContent = settings.site_description;
                });
        }

        /*
        --------------------------------------------------------
        HERO
        --------------------------------------------------------
        */

        if (settings.hero_title) {

            document
                .querySelectorAll(
                    "[data-hero-title], .hero h1"
                )
                .forEach(el => {
                    el.textContent = settings.hero_title;
                });
        }

        if (settings.hero_text) {

            document
                .querySelectorAll(
                    "[data-hero-text], .hero p"
                )
                .forEach(el => {
                    el.textContent = settings.hero_text;
                });
        }

        /*
        --------------------------------------------------------
        FOOTER
        --------------------------------------------------------
        */

        if (settings.footer_text) {

            document
                .querySelectorAll(
                    "[data-footer-text], .footer-text"
                )
                .forEach(el => {
                    el.textContent = settings.footer_text;
                });
        }

        /*
        --------------------------------------------------------
        MÜHENDİSLİKLER
        --------------------------------------------------------
        */

        const engineering =
            Array.isArray(data.engineering)
                ? data.engineering
                : [];

        window.MUHENDISLIKLer = engineering;

        /*
        Mevcut mühendislik kartlarını bul.
        Eğer sayfada özel data-container varsa onu kullan.
        */

        const engineeringContainers = [
            "#muhendislik-listesi",
            "#engineering-list",
            "#engineering-grid",
            ".engineering-grid",
            ".engineering-list",
            "[data-engineering-list]"
        ];

        let engineeringContainer = null;

        for (const selector of engineeringContainers) {

            const el = document.querySelector(selector);

            if (el) {
                engineeringContainer = el;
                break;
            }
        }

        if (engineeringContainer && engineering.length) {

            engineeringContainer.innerHTML = "";

            engineering.forEach(item => {

                const card = document.createElement("article");

                card.className =
                    "engineering-card live-engineering-card";

                card.dataset.id = item.id;

                const shortText =
                    item.kisa ||
                    item.description ||
                    item.nedir ||
                    "";

                card.innerHTML = `
                    <div class="engineering-card-inner">

                        <h3>
                            ${escapeLive(item.name || "Mühendislik")}
                        </h3>

                        <p>
                            ${escapeLive(shortText)}
                        </p>

                        ${
                            item.salary
                                ? `
                                <div class="engineering-salary">
                                    ${escapeLive(item.salary)}
                                </div>
                                `
                                : ""
                        }

                    </div>
                `;

                engineeringContainer.appendChild(card);
            });
        }

        /*
        --------------------------------------------------------
        ÜNİVERSİTELER
        --------------------------------------------------------
        */

        const universities =
            Array.isArray(data.universities)
                ? data.universities
                : [];

        window.MUHENDISLIK_UNIVERSITELERI = universities;

        const universityTable =
            document.querySelector(
                "#universite table, #universite-table, table[data-universities]"
            );

        if (universityTable && universities.length) {

            let tbody =
                universityTable.querySelector("tbody");

            if (!tbody) {

                tbody =
                    document.createElement("tbody");

                universityTable.appendChild(tbody);
            }

            tbody.innerHTML = "";

            universities.forEach(item => {

                const tr =
                    document.createElement("tr");

                tr.innerHTML = `
                    <td>${escapeLive(item.name || "")}</td>
                    <td>${escapeLive(item.department || "")}</td>
                    <td>${escapeLive(item.score || "—")}</td>
                    <td>${escapeLive(item.ranking || "—")}</td>
                `;

                tbody.appendChild(tr);
            });
        }

        /*
        --------------------------------------------------------
        MAAŞLAR
        --------------------------------------------------------
        */

        const salaries =
            Array.isArray(data.salaries)
                ? data.salaries
                : [];

        window.MUHENDISLIK_MAASLARI = salaries;

        const salaryTable =
            document.querySelector(
                "#salaries table, #salary-table, table[data-salaries]"
            );

        if (salaryTable && salaries.length) {

            let tbody =
                salaryTable.querySelector("tbody");

            if (!tbody) {

                tbody =
                    document.createElement("tbody");

                salaryTable.appendChild(tbody);
            }

            tbody.innerHTML = "";

            salaries.forEach(item => {

                const tr =
                    document.createElement("tr");

                tr.innerHTML = `
                    <td>
                        ${escapeLive(item.engineering || "")}
                    </td>

                    <td>
                        ${escapeLive(item.sector || "")}
                    </td>

                    <td>
                        ${escapeLive(String(item.year || ""))}
                    </td>

                    <td>
                        ${escapeLive(item.salary || "")}
                    </td>

                    <td>
                        ${escapeLive(item.source || "")}
                    </td>
                `;

                tbody.appendChild(tr);
            });
        }

        /*
        --------------------------------------------------------
        HABERLER
        --------------------------------------------------------
        */

        const news =
            Array.isArray(data.news)
                ? data.news
                : [];

        window.MUHENDISLIK_HABERLERI = news;

        const newsContainers = [
            "#haberler-list",
            "#news-list",
            ".news-list",
            ".news-grid",
            "[data-news-list]"
        ];

        let newsContainer = null;

        for (const selector of newsContainers) {

            const el =
                document.querySelector(selector);

            if (el) {
                newsContainer = el;
                break;
            }
        }

        if (newsContainer && news.length) {

            newsContainer.innerHTML = "";

            news.forEach(item => {

                const article =
                    document.createElement("article");

                article.className =
                    "news-card live-news-card";

                article.innerHTML = `
                    <div class="news-source">
                        ${(item.source || "Mühendislik Merkezi")}
                    </div>

                    <h3>
                        ${escapeLive(item.title || "")}
                    </h3>

                    <p>
                        ${escapeLive(item.text || "")}
                    </p>

                    ${
                        item.url
                            ? `
                            <a
                                href="${escapeLive(item.url)}"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Haberin tamamını görüntüle →
                            </a>
                            `
                            : ""
                    }
                `;

                newsContainer.appendChild(article);
            });
        }

        /*
        --------------------------------------------------------
        GENERIC DATA ATTRIBUTES
        --------------------------------------------------------
        Bunları HTML'de kullanırsan admin değişiklikleri
        doğrudan ilgili elemente yazılır.
        --------------------------------------------------------
        */

        document
            .querySelectorAll("[data-live-field]")
            .forEach(el => {

                const field =
                    el.getAttribute("data-live-field");

                const value =
                    settings[field];

                if (
                    value !== undefined &&
                    value !== null
                ) {
                    el.textContent = value;
                }
            });

        /*
        --------------------------------------------------------
        BAŞARILI
        --------------------------------------------------------
        */

        document.documentElement
            .setAttribute(
                "data-admin-sync",
                "ok"
            );

        console.log(
            "✓ Admin → Ana site senkronizasyonu tamamlandı.",
            data
        );

    } catch (error) {

        console.error(
            "Canlı site senkronizasyon hatası:",
            error
        );

    }

})();


function escapeLive(value) {

    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/*
============================================================
ADMIN DEĞİŞİKLİĞİNDEN SONRA SAYFAYI TAZELEME
============================================================
*/

window.addEventListener(
    "pageshow",
    function() {

        /*
        Browser back/forward cache yüzünden eski içerik
        kalmasın.
        */

        if (
            performance &&
            performance.getEntriesByType
        ) {

            const entries =
                performance.getEntriesByType(
                    "navigation"
                );

            if (
                entries.length &&
                entries[0].type === "back_forward"
            ) {
                location.reload();
            }
        }

    }
);

</script>

