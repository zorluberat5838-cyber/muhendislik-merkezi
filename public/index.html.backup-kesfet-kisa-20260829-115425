<script>
/* Arama sonuçları açılmadığında kutunun gereksiz boşluk bırakmasını engelle */
(function(){
    const sonuc = document.getElementById("kesfetSonuc");

    if(!sonuc) return;

    const observer = new MutationObserver(function(){
        if(!sonuc.innerHTML.trim()){
            sonuc.style.display = "none";
        }else{
            sonuc.style.display = "block";
        }
    });

    observer.observe(sonuc,{
        childList:true,
        subtree:true,
        characterData:true
    });

    if(!sonuc.innerHTML.trim()){
        sonuc.style.display = "none";
    }
})();
</script>

