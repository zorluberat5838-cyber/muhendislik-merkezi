function searchSite(){

    const value =
        document
        .getElementById("searchInput")
        .value
        .toLowerCase()
        .trim();

    if(!value){

        alert("Aramak istediğin şeyi yaz.");

        return;

    }

    const elements =
        document.querySelectorAll(
            ".eng,.category,.news-card"
        );

    let found = false;

    elements.forEach(element=>{

        if(
            element.innerText
            .toLowerCase()
            .includes(value)
        ){

            element.scrollIntoView({
                behavior:"smooth",
                block:"center"
            });

            element.style.outline =
                "3px solid #2563eb";

            setTimeout(()=>{

                element.style.outline = "";

            },2000);

            found = true;

        }

    });

    if(!found){

        alert(
            `"${value}" için sonuç bulunamadı.`
        );

    }

}


async function loadNews(){

