                    : String(item?.alanlar || "");

            const isler =
                Array.isArray(item?.isler)
                    ? item.isler.join(" ")
                    : String(item?.isler || item?.work || "");

            const dersler =
                Array.isArray(item?.dersler)
                    ? item.dersler.join(" ")
                    : String(item?.dersler || item?.education || "");

            const kariyer =
                String(item?.kariyer || "");

            const etiket =
                Array.isArray(item?.etiket)
                    ? item.etiket.join(" ")
                    : String(item?.etiket || "");

            const salary =
                String(item?.salary || "");

            const aramaMetni = normalize([
                name,
                description,
                alanlar,
                isler,
                dersler,
                kariyer,
                etiket,
                salary
            ].join(" "));

            let skor = 0;

            /*
            Tam isim eşleşmesi en yüksek puan
            */

            if(normalize(name) === aranan){
                skor += 100;
            }

            if(normalize(name).includes(aranan)){
                skor += 70;
            }

            /*
            Genişletilmiş anahtar kelimeler
            */

            genisArama.forEach(kelime => {

                if(!kelime) return;

                if(aramaMetni.includes(kelime)){

                    skor += 12;

                    if(normalize(name).includes(kelime)){
                        skor += 25;
                    }
                }
            });

            /*
            Birden fazla kelimeyle arama:
            "yapay zeka mühendislik" gibi
            */

            aranan
                .split(/\s+/)
                .filter(Boolean)
                .forEach(kelime => {

                    if(kelime.length >= 2 &&
                       aramaMetni.includes(kelime)){

                        skor += 8;
                    }
                });

            return {
                item,
                name,
                description,
                skor
            };

        })
        .filter(x => x.skor > 0)
        .sort((a,b) => b.skor - a.skor);

    /*
    Sonuç yoksa bazı genel yönlendirmeler göster
    */

    if(!bulunan.length){

        sonuc.innerHTML = `
            <div style="
                margin-top:12px;
                padding:16px;
                border-radius:14px;
                background:linear-gradient(145deg,#0b2038,#102f50);
                border:1px solid #285575;
                color:#dcecff;
                line-height:1.6;
            ">
                ❌ <strong>Sonuç bulunamadı.</strong>
                <div style="
                    margin-top:7px;
                    font-size:13px;
                    opacity:.85;
                ">
                    Örnek: bilgisayar, yazılım, yapay zeka,
                    elektrik, makine, robotik, uzay, üniversite,
                    YKS, TYT, AYT, maaş, kariyer...
                </div>
            </div>
        `;

        return;
    }

    /*
    Sonuçları göster
    */

    sonuc.innerHTML = bulunan
        .slice(0,8)
        .map(x => {

            const safeName =
                String(x.name)
                    .replace(/\\/g,"\\\\")
                    .replace(/'/g,"\\'")
                    .replace(/"/g,"&quot;");

            const safeDescription =
                String(x.description || "")
                    .replace(/</g,"&lt;")
                    .replace(/>/g,"&gt;");

            return `
                <div
                    onclick="muhendislikAc('${safeName}')"
                    style="
                        padding:15px;
                        margin-top:9px;
                        background:linear-gradient(
                            145deg,
                            #0b2038,
                            #102f50
                        );
                        border:1px solid #285575;
                        border-radius:13px;
                        cursor:pointer;
                        transition:
                            transform .22s ease,
                            border-color .22s ease,
                            box-shadow .22s ease;
                    "
                    onmouseenter="
                        this.style.transform='translateY(-2px)';
                        this.style.borderColor='#4d8bb5';
                        this.style.boxShadow='0 8px 22px rgba(0,0,0,.25)';
                    "
                    onmouseleave="
                        this.style.transform='';
                        this.style.borderColor='#285575';
                        this.style.boxShadow='';
                    "
                >
                    <strong style="
                        color:#ffffff;
                        font-size:15px;
                    ">
                        ${safeName}
                    </strong>

                    ${
                        safeDescription
                        ? `
                            <br>
                            <small style="
                                color:#c4cee0;
                                display:block;
                                margin-top:5px;
                            ">
                                ${safeDescription}
                            </small>
                        `
                        : ""
                    }

                    <div style="
                        margin-top:8px;
                        font-size:11px;
                        color:#78b8e8;
                    ">
                        Mühendislik bilgisini görüntüle →
                    </div>
                </div>
            `;

        })
        .join("");
}

function bolumeGit(id){
    const hedef=document.getElementById(id);

    if(!hedef) return;

    hedef.scrollIntoView({
        behavior:"smooth",
        block:"start"
    });
}

function muhendislikAc(ad){
    bolumeGit("muhendislik");

    setTimeout(()=>{
        const kartlar=document.querySelectorAll(".engineering .eng,.engineering > div");

        kartlar.forEach(k=>{
            if(k.innerText && k.innerText.includes(ad)){
                k.scrollIntoView({
                    behavior:"smooth",
                    block:"center"
                });

                k.style.outline="3px solid #4da3ff";

                setTimeout(()=>{
                    k.style.outline="";
                },2000);
            }
        });
    },500);
}

function gununMuhendisligi(){
    bolumeGit("muhendislik");
}

