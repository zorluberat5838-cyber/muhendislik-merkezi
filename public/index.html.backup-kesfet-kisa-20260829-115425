<script id="MM-LIVE-ENGINEERING-FINAL">
(function(){

    "use strict";

    function escapeHTML(value){

        return String(value ?? "")
            .replace(/&/g,"&amp;")
            .replace(/</g,"&lt;")
            .replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;")
            .replace(/'/g,"&#039;");

    }

    async function loadLiveEngineering(){

        const containers = [

            document.getElementById("muhendislik-listesi"),

            document.getElementById("engineering-list"),

            document.getElementById("engineering-grid"),

            document.querySelector(".engineering-grid"),

            document.querySelector(".engineering-list")

        ].filter(Boolean);

        const container = containers[0];

        if(!container){

            console.warn("Mühendislik container bulunamadı.");
            return;

        }

        try{

            const response = await fetch(
                "/api/engineering?t=" + Date.now(),
                {
                    cache:"no-store",
                    headers:{
                        "Cache-Control":"no-cache"
                    }
                }
            );

            if(!response.ok){

                throw new Error(
                    "API HTTP " + response.status
                );

            }

            const data = await response.json();

            if(!Array.isArray(data)){

                throw new Error(
                    "Mühendislik API geçersiz veri döndürdü."
                );

            }

            container.innerHTML = "";

            if(data.length === 0){

                container.innerHTML = `
                    <div style="
                        width:100%;
                        padding:40px;
                        text-align:center;
                        color:#7f8b99;
                    ">
                        Henüz mühendislik eklenmemiş.
                    </div>
                `;

                return;

            }

            data.forEach(function(item){

                const card = document.createElement("div");

                card.className =
                    "engineering-card live-engineering-card";

                card.dataset.id =
                    item.id || "";

                const title =
                    item.name ||
                    "Mühendislik";

                const description =
                    item.kisa ||
                    item.nedir ||
                    item.description ||
                    "Mühendislik bölümü hakkında bilgi.";

                const salary =
                    item.salary || "";

                card.innerHTML = `

                    <div class="engineering-card-inner">

                        <h3>
                            ${escapeHTML(title)}
                        </h3>

                        <p>
                            ${escapeHTML(description)}
                        </p>

                        ${
                            salary
                            ?
                            `
                            <div class="engineering-salary">
                                ${escapeHTML(salary)}
                            </div>
                            `
                            :
                            ""
                        }

                    </div>

                `;

                container.appendChild(card);

            });

            console.log(
                "✅ Canlı mühendislikler yüklendi:",
                data.length
            );

        }catch(error){

            console.error(
                "Canlı mühendislik yüklenemedi:",
                error
            );

            container.innerHTML = `
                <div style="
                    width:100%;
                    padding:30px;
                    text-align:center;
                    color:#ff5c6c;
                ">
                    Mühendislik bilgileri yüklenemedi.
                    <br>
                    <small>
                        Sayfayı yenilemeyi deneyin.
                    </small>
                </div>
            `;

        }

    }

    /*
     * DOM tamamen hazır olduğunda çalış.
     */

    if(document.readyState === "loading"){

        document.addEventListener(
            "DOMContentLoaded",
            loadLiveEngineering
        );

    }else{

        loadLiveEngineering();

    }

    /*
     * Admin değişiklik yaptıktan sonra
     * kullanıcı sayfayı açık tutuyorsa
     * 30 saniyede bir güncelle.
     */

    setInterval(
        loadLiveEngineering,
        30000
    );

})();
</script>

