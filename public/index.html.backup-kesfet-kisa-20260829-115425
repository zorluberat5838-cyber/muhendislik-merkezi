<title>Mühendislik Merkezi | Eğitim ve Kariyer</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f5f7fb;
    color:#172033;
}

/* ÜST BAR */

.top{
    background:#111827;
    color:white;
    padding:9px 6%;
    display:flex;
    justify-content:space-between;
    font-size:14px;
}

/* HEADER */

header{
    background:white;
    border-bottom:1px solid #e5e7eb;
    position:sticky;
    top:0;
    z-index:1000;
}

.nav{
    max-width:1250px;
    margin:auto;
    min-height:80px;
    padding:0 20px;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:30px;
}

.logo{
    font-size:24px;
    font-weight:800;
    color:#2563eb;
}

.logo span{
    color:#7c3aed;
}

.menu{
    display:flex;
    gap:25px;
    align-items:center;
}

.menu a{
    text-decoration:none;
    color:#374151;
    font-weight:600;
}

.menu a:hover{
    color:#2563eb;
}

/* ARAMA */

.search{
    max-width:1250px;
    margin:auto;
    padding:15px 20px;
    display:flex;
    gap:10px;
}

.search input{
    width:100%;
    padding:14px 18px;
    border:1px solid #d1d5db;
    border-radius:10px;
    font-size:15px;
    outline:none;
}

.search button{
    border:0;
    background:#2563eb;
    color:white;
    padding:0 25px;
    border-radius:10px;
    cursor:pointer;
    font-weight:bold;
}

/* HERO */

.hero{
    background:
    linear-gradient(120deg,#eef4ff,#ffffff,#f5efff);

    padding:90px 20px;
}

.hero-inner{
    max-width:1150px;
    margin:auto;
}

.hero h1{
    font-size:55px;
    max-width:800px;
    line-height:1.08;
    margin-bottom:20px;
}

.hero h1 span{
    color:#2563eb;
}

.hero p{
    max-width:700px;
    color:#64748b;
    font-size:18px;
    line-height:1.7;
}

.buttons{
    display:flex;
    gap:12px;
    margin-top:30px;
    flex-wrap:wrap;
}

.btn{
    padding:14px 22px;
    border-radius:9px;
    text-decoration:none;
    font-weight:bold;
    display:inline-block;
}

.blue{
    background:#2563eb;
    color:white;
}

.purple{
    background:#7c3aed;
    color:white;
}

.white{
    background:white;
    color:#1f2937;
    border:1px solid #d1d5db;
}

/* GENEL */

.container{
    max-width:1250px;
    margin:auto;
    padding:75px 20px;
}

.title{
    margin-bottom:35px;
}

.title h2{
    font-size:34px;
    margin-bottom:10px;
}

.title p{
    color:#64748b;
}

/* KATEGORİLER */

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
}

.category{
    background:white;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:25px;
    cursor:pointer;
    transition:.25s;
}

.category:hover{
    transform:translateY(-5px);
    box-shadow:0 12px 30px rgba(37,99,235,.12);
    border-color:#93c5fd;
}

.category .icon{
    font-size:32px;
    margin-bottom:15px;
}

.category h3{
    margin-bottom:8px;
}

.category p{
    color:#64748b;
    line-height:1.5;
}

/* MÜHENDİSLİKLER */

.engineering{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:15px;
}

.eng{
    background:white;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:20px;
    transition:.25s;
}

.eng:hover{
    transform:translateY(-4px);
    border-color:#7c3aed;
}

.eng h3{
    margin-bottom:8px;
    font-size:17px;
}

.eng p{
    color:#64748b;
    font-size:14px;
}

/* İSTATİSTİK */

.stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
    gap:18px;
}

.stat{
    background:white;
    border:1px solid #e5e7eb;
    padding:30px;
    border-radius:14px;
}

.stat strong{
    font-size:34px;
    color:#2563eb;
    display:block;
    margin-bottom:8px;
}

.stat span{
    color:#64748b;
}

/* TABLOLAR */

.table-box{
    overflow-x:auto;
    background:white;
    border:1px solid #e5e7eb;
    border-radius:14px;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:16px;
    text-align:left;
    border-bottom:1px solid #e5e7eb;
}

th{
    background:#f8fafc;
}

/* HABERLER */

.news{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
    gap:20px;
}

.news-card{
    background:white;
    padding:25px;
    border:1px solid #e5e7eb;
    border-radius:14px;
}

.news-card small{
    color:#2563eb;
}

.news-card h3{
    margin:12px 0;
}

.news-card p{
    color:#64748b;
    line-height:1.6;
}

/* FOOTER */

footer{
    background:#111827;
    color:white;
    padding:50px 20px;
}

.footer-inner{
    max-width:1250px;
    margin:auto;

    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:35px;
}

footer h3{
    margin-bottom:15px;
}

footer p,
footer a{
    color:#9ca3af;
    line-height:1.8;
    text-decoration:none;
}

.bottom{
    max-width:1250px;
    margin:35px auto 0;
    padding-top:20px;
    border-top:1px solid #374151;
    color:#9ca3af;
}

/* MOBİL */

@media(max-width:800px){

    .menu{
        display:none;
    }

    .hero h1{
        font-size:40px;
    }

    .top{
        display:none;
    }

}


.site-logo {
    width: 55px;
    height: 55px;
    object-fit: contain;
    display: block;
}


/* KEŞFET */
.discover-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin-top:25px;
}

.discover-card{
    background:linear-gradient(145deg,#111a30,#0d1426);
    border:1px solid #263654;
    border-radius:20px;
    padding:25px;
    min-height:190px;
    cursor:pointer;
    transition:.25s ease;
    box-shadow:0 10px 30px rgba(0,0,0,.18);
}

.discover-card:hover{
    transform:translateY(-6px);
    border-color:#4da3ff;
    box-shadow:0 15px 35px rgba(0,0,0,.3);
}

.discover-icon{
    font-size:34px;
    margin-bottom:12px;
}

.discover-card h3{
    margin:5px 0 10px;
    font-size:20px;
}

.discover-card p{
    color:#9eabc4;
    line-height:1.6;
}

.discover-card strong{
    display:inline-block;
    margin-top:8px;
    color:#4da3ff;
}

.discover-search{
    grid-column:span 2;
}

.discover-search-box{
    display:flex;
    gap:10px;
    margin-top:18px;
}

.discover-search-box input{
    flex:1;
    margin:0;
}

.discover-search-box button{
    border:0;
    border-radius:10px;
    padding:0 20px;
    background:#287cff;
    color:white;
    font-weight:700;
    cursor:pointer;
}

#kesfetSonuc{
    margin-top:12px;
    color:#8fc5ff;
}

@media(max-width:900px){
    .discover-grid{
        grid-template-columns:1fr 1fr;
    }

    .discover-search{
        grid-column:span 2;
    }
}

@media(max-width:600px){
    .discover-grid{
        grid-template-columns:1fr;
    }

    .discover-search{
        grid-column:span 1;
    }
}

</style>







