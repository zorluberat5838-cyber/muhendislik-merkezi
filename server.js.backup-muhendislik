// Admin tarafından siteyi kaydetmek
app.put("/api/admin/customization", adminAuth, (req, res) => {

    const allowed = [
        "site_name",
        "site_description",
        "hero_title",
        "hero_text",
        "technician",
        "footer_text"
    ];

    try {

        const current = db.prepare(`
            SELECT *
            FROM site_settings
            WHERE id = 1
        `).get() || {};

        const values = {};

        for (const key of allowed) {

            if (Object.prototype.hasOwnProperty.call(req.body, key)) {
                values[key] = String(req.body[key] ?? "").trim();
            } else {
                values[key] = current[key] ?? "";
            }

        }

        db.prepare(`
            UPDATE site_settings
            SET
                site_name = ?,
                site_description = ?,
                hero_title = ?,
                hero_text = ?,
                technician = ?,
                footer_text = ?
            WHERE id = 1
        `).run(
            values.site_name,
            values.site_description,
            values.hero_title,
            values.hero_text,
            values.technician,
            values.footer_text
        );

        const updated = db.prepare(`
            SELECT *
            FROM site_settings
            WHERE id = 1
        `).get();

        res.json({
            success: true,
            message: "Değişiklikler başarıyla yayınlandı.",
            settings: updated
        });

    } catch (error) {

        console.error("Customization PUT:", error);

        res.status(500).json({
            success: false,
            message: "Değişiklikler kaydedilemedi."
        });
    }
});


// Tek bir site alanını canlı değiştirmek
app.patch("/api/admin/customization/:field", adminAuth, (req, res) => {

    const allowed = [
        "site_name",
        "site_description",
        "hero_title",
        "hero_text",
        "technician",
        "footer_text"
    ];

    const field = req.params.field;

    if (!allowed.includes(field)) {

        return res.status(400).json({
            success: false,
            message: "Bu alan değiştirilemez."
        });
    }

    try {

        const value = String(
            req.body.value ?? ""
        ).trim();

        const sql = `
            UPDATE site_settings
            SET ${field} = ?
            WHERE id = 1
        `;

        db.prepare(sql).run(value);

        res.json({
            success: true,
            field,
            value,
            message: "Alan güncellendi."
        });

    } catch (error) {

        console.error("Customization PATCH:", error);

        res.status(500).json({
            success: false,
            message: "Alan güncellenemedi."
        });
    }
});


// Özelleştirme modunda değişiklikleri kontrol etmek
app.get("/api/admin/customization/status", adminAuth, (req, res) => {

    try {

        const settings = db.prepare(`
            SELECT *
            FROM site_settings
            WHERE id = 1
        `).get();

        res.json({
            success: true,
            active: true,
            last_update: new Date().toISOString(),
            settings
        });

    } catch (error) {

        console.error("Customization status:", error);

        res.status(500).json({
            success: false
        });
    }
});



app.listen(PORT, () => {
    console.log(`Site: http://localhost:${PORT}`);
    console.log(`Admin: http://localhost:${PORT}/admin`);
});
